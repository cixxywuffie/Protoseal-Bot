BOT_TOKEN=replace-with-your-discord-token
#Optional property. You can add a donation URL
DONATION_URL=

# MariaDB environment variables
DB_NAME=protoseal_dev
DB_USERNAME=protoseal
DB_PASSWORD=replace-with-a-development-password
DB_ROOT_PASSWORD=replace-with-a-root-password

# The host is the MariaDB service name on the internal Compose network.
DB_URL=jdbc:mariadb://mariadb:3306/

# APP Internal properties
JPA_DDL_AUTO=update
HIBERNATE_JDBC_TIME_ZONE=UTC
SPRING_PROFILES_ACTIVE=development
APP_LOG_LEVEL=INFO

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0
